# Copy to .env in this folder:  cp .env.example .env
# Used by: docker compose (Postgres + Kafka ports only)

# --- Postgres (docker-compose postgres service) ---
POSTGRES_USER=deriv
POSTGRES_PASSWORD=deriv
POSTGRES_DB=deriv
POSTGRES_HOST_PORT=5432

# --- Kafka + UI (docker-compose kafka / kafka-ui services) ---
# Host clients use localhost:9092; Kafka UI uses kafka:9094 inside Docker network.
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8081

# --- Also set in backend/.env (FastAPI); install deps: cd backend && uv sync ---
# POSTGRES_DATABASE_URL=postgresql+asyncpg://deriv:deriv@localhost:5432/deriv
# KAFKA_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Also set in frontend/.env (Next.js / Prisma) ---
# DATABASE_URL=postgresql://deriv:deriv@localhost:5432/deriv

# --- Also set in workers/.env ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
