# Optional: copy to jenkins/config/dev.env in workspace to override Jenkins global env.
# Preferred: Manage Jenkins → System → Global properties → ECR_REGISTRY, AWS_REGION
# ECR host only (no repository suffix), e.g. 123456789012.dkr.ecr.us-west-1.amazonaws.com
#
# terraform -chdir=infrastructure/terraform/environments/dev output -json ecr_repository_urls

AWS_REGION=us-west-1
ECR_REGISTRY=

# EKS deploy (terraform output / eks.yml)
EKS_CLUSTER_NAME=deriv-ai-bot-dev
APP_ACM_CERTIFICATE_ARN=
API_ACM_CERTIFICATE_ARN=
APP_DOMAIN=app.testenvlab.shop
API_DOMAIN=api.testenvlab.shop

# Frontend image build (browser calls API on this host)
NEXT_PUBLIC_BOT_BASE_URL=https://api.testenvlab.shop
