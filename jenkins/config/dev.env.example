# Copy to jenkins/config/dev.env in workspace (gitignored) or set the same keys as Jenkins global env.
# Infra config only — secrets live in AWS Secrets Manager (PLATFORM_SECRET_ID).
#
# Populate from: cd infrastructure/terraform/environments/dev && terraform output

AWS_REGION=us-west-1
ECR_REGISTRY=891377245316.dkr.ecr.us-west-1.amazonaws.com

EKS_CLUSTER_NAME=deriv-ai-bot-dev
VPC_ID=vpc-0c167ee93964632d7

ALB_CONTROLLER_ROLE_ARN=arn:aws:iam::891377245316:role/deriv-ai-bot-dev-aws-lb-controller
EXTERNAL_DNS_ROLE_ARN=arn:aws:iam::891377245316:role/deriv-ai-bot-dev-external-dns
EXTERNAL_DNS_DOMAIN_FILTER=testenvlab.shop
EXTERNAL_DNS_TXT_OWNER_ID=deriv-dev

APP_ACM_CERTIFICATE_ARN=arn:aws:acm:us-west-1:891377245316:certificate/4eedcfe4-eb5d-4dc7-b117-5d8ba38ea839
API_ACM_CERTIFICATE_ARN=arn:aws:acm:us-west-1:891377245316:certificate/72d1612c-82f7-4875-947e-2ad0244dd0ac

APP_DOMAIN=app.testenvlab.shop
API_DOMAIN=api.testenvlab.shop

# AWS Secrets Manager secret name (JSON: POSTGRES_PASSWORD, AUTH_SECRET, OPENAI_API_KEY)
PLATFORM_SECRET_ID=deriv-ai-bot/dev/platform

# Frontend image build (browser calls API on this host)
NEXT_PUBLIC_BOT_BASE_URL=https://api.testenvlab.shop

# Grafana / Loki (terraform output loki_s3_bucket, loki_role_arn)
LOKI_S3_BUCKET=
LOKI_ROLE_ARN=
# Set to false to skip Loki/Promtail/Grafana on platform deploy
MONITORING_ENABLED=true

# Park / wake (optional; Jenkins discovers instance by tag Name=deriv-ai-bot-jenkins-dev)
# JENKINS_INSTANCE_ID=
EKS_NODE_DESIRED_SIZE=1
EKS_NODE_MAX_SIZE=2
# Optional; auto-generated in cluster secret grafana-admin if unset
# GRAFANA_ADMIN_PASSWORD=
