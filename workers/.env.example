# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CANDLES_BTC=candles-btc
KAFKA_TOPIC_CANDLES_GOLD=candles-gold

# Worker pool
WORKER_ENABLE_BINANCE=true
WORKER_ENABLE_DERIV=true

# Binance (public market data; keys optional for later signed endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOL=BTCUSDT
BINANCE_TIMEFRAMES=1s,1m

# Deriv gold
DERIV_APP_ID=1089
DERIV_TOKEN=
DERIV_WS_ENDPOINT=wss://ws.derivws.com/websockets/v3
DERIV_SYMBOL=frxXAUUSD
DERIV_TIMEFRAMES=1s,1m,2m,3m
