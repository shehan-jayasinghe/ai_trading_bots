# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CANDLES_BTC=candles-btc
KAFKA_TOPIC_CANDLES_GOLD=candles-gold
KAFKA_TOPIC_MARKET_TRADES=market-trades
KAFKA_TOPIC_MARKET_ORDERBOOK=market-orderbook
KAFKA_TOPIC_MARKET_FLOW=market-flow

# Worker pool
WORKER_ENABLE_BINANCE=true
WORKER_ENABLE_BINANCE_FLOW=true
WORKER_ENABLE_DERIV=false

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_COMBINED_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_SYMBOL=BTCUSDT
BINANCE_TIMEFRAMES=1s,1m
BINANCE_FLOW_LIQUIDITY_PCT=0.005

# Deriv gold (optional)
DERIV_APP_ID=1089
DERIV_TOKEN=
DERIV_WS_ENDPOINT=wss://ws.derivws.com/websockets/v3
DERIV_SYMBOL=frxXAUUSD
DERIV_TIMEFRAMES=1s,1m,2m,3m
