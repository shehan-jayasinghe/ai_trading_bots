HOST=0.0.0.0
PORT=8000
RELOAD=true

AUTH_SECRET=your-auth-secret-must-match-frontend
POSTGRES_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/deriv_ai_bot

